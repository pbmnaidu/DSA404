# ─────────────────────────────────────────────────────────────
# DSA⁴⁰⁴ — Environment Variables Example
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Client-side Firebase (public, exposed to browser) ────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# ── Server-side Firebase Admin (NEVER expose to browser) ─────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Gmail SMTP (server-side only) ────────────────────────────
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ── Admin Setup (used ONLY by scripts/set-admin-claim.ts) ────
# This is the email address that will receive the admin custom claim.
# It is NEVER used in frontend code or client-side authorization.
ADMIN_EMAIL=your-admin-email@example.com

# ── GitHub Auto-Push Integration ─────────────────────────────
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
GITHUB_ENCRYPTION_KEY=32_character_minimum_random_string
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin-account@gmail.com

# ── Cloud Functions Environment Variables ────────────────────
# Set these in functions/.env (non-sensitive):
#   GMAIL_USER=your-email@gmail.com
#   ADMIN_NOTIFY_EMAIL=admin-account@gmail.com
#
# Set these as Firebase secrets (sensitive):
#   firebase functions:secrets:set GMAIL_APP_PASSWORD
